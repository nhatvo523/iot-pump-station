{
  "uid": "ps01-monitoring",
  "title": "PS01 - Pump Station Monitoring",
  "description": "Live readings and historical trends from TDengine. Grafana independently evaluates level >=85% and pressure >6 bar every 10 seconds. Simulator alarm transitions retain its own hysteresis.",
  "tags": [
    "iot",
    "pump-station",
    "PS01"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tank level",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "tdengine-ps01"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "tdengine-ps01"
          },
          "queryType": "SQL",
          "sql": "SELECT ts, val AS Level FROM iot_ps.ps01_lt01 WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 1",
          "formatType": "Time series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 10,
                "color": "orange"
              },
              {
                "value": 20,
                "color": "green"
              },
              {
                "value": 85,
                "color": "orange"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(?!ts$).*/"
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
