              "relativeTimeRange": {
                "from": 30,
                "to": 0
              },
              "datasourceUid": "tdengine-ps01",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "tdengine-datasource",
                  "uid": "tdengine-ps01"
                },
                "queryType": "SQL",
                "sql": "SELECT ts, CASE WHEN active_alarms MATCH '(^|,)LOW_LEVEL(,|$)' THEN 1 ELSE 0 END AS reading FROM iot_ps.ps01_state WHERE ts > NOW - 30s ORDER BY ts DESC LIMIT 1",
